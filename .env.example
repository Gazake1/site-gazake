# Example environment variables for Gazake Bots (Easy Panel)
# Copy to .env and set real values in your deployment.

# Server
PORT=3000

# Session DB file (relative to project root)
SESS_DB=sessions.sqlite

# Users DB file
USERS_DB=database.sqlite

# Session secret (change to a strong random string in production)
SESSION_SECRET=replace_with_a_strong_secret

# Trust proxy (set to 1 when running behind a reverse proxy)
TRUST_PROXY=1

# Set to 1 when using HTTPS to mark cookies secure
COOKIE_SECURE=1

# Admin key to access /admin/users (set a strong value)
ADMIN_KEY=replace_with_admin_key
